# ---------- Server ----------
PORT=3000
# Public base URL of this app. OAuth redirect URIs are built from it:
#   {PUBLIC_URL}/api/oauth/meta/callback, /google/callback
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
DATA_DIR=./data

# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=

# First admin (created on first start only, when no users exist). Min 12 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- AI (Claude) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- AI (Groq, optional alternative) ----------
# Set GROQ_API_KEY (console.groq.com/keys). Used automatically when ANTHROPIC_API_KEY is empty,
# or force a provider with AI_PROVIDER=groq | anthropic.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=

# ---------- Meta Marketing API ----------
# developers.facebook.com → your app → Marketing API product; add the redirect URI under Facebook Login.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v24.0
# Facebook Login for Business apps only: configuration ID (must include pages_manage_posts)
META_CONFIG_ID=

# ---------- Google Ads API ----------
# OAuth client (Web application) from Google Cloud Console + developer token from your Google Ads manager account.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: manager (MCC) id used as login-customer-id when not detected automatically (digits only)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# ---------- Budget hard caps (per campaign, account currency) ----------
MAX_DAILY_BUDGET_PER_CAMPAIGN=500
MAX_TOTAL_BUDGET_PER_CAMPAIGN=10000

# ---------- Scheduler ----------
SCHEDULER_TICK_SECONDS=60
METRICS_SYNC_MINUTES=30
AI_OPTIMIZE_EVERY_HOURS=24

# ---------- Notifications (optional) ----------
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
SLACK_WEBHOOK_URL=
